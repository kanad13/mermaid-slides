{
	"name": "mermaid-slides",
	"version": "1.6.0",
	"description": "Transform your markdown mermaid diagrams into beautiful presentation slides",
	"type": "module",
	"scripts": {
		"dev": "vite --config config/vite.config.js",
		"build": "vite build --config config/vite.config.js",
		"build:offline": "vite build --config config/vite.config.js --mode offline --outDir offline-package && node scripts/prepare-offline-package.cjs",
		"preview": "vite preview --config config/vite.config.js",
		"lint": "eslint . --config config/eslint.config.js --report-unused-disable-directives --max-warnings 0",
		"typecheck": "tsc --noEmit -p config/tsconfig.json",
		"test": "vitest --config config/vite.config.js",
		"test:ui": "vitest --ui --config config/vite.config.js",
		"test:run": "vitest run --config config/vite.config.js",
		"validate:compatibility": "node scripts/validate-compatibility.cjs",
		"validate:continuity": "node scripts/validate-continuity.cjs",
		"validate:all": "npm run typecheck && npm run lint && npm run test:run && npm run validate:compatibility && npm run validate:continuity"
	},
	"keywords": [
		"mermaid",
		"markdown",
		"presentation",
		"slides",
		"diagrams",
		"visualization",
		"react",
		"documentation"
	],
	"author": "Kunal Pathak <kunal.pathak13@gmail.com> (https://www.kunal-pathak.com)",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/kanad13/mermaid-slides.git"
	},
	"bugs": {
		"url": "https://github.com/kanad13/mermaid-slides/issues"
	},
	"homepage": "https://mermaid-slides.com/",
	"dependencies": {
		"lucide-react": "^0.525.0",
		"mermaid": "^11.16.1",
		"react": "^19.2.8",
		"react-dom": "^19.2.8"
	},
	"devDependencies": {
		"@eslint/js": "^9.30.0",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.4",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react-swc": "^3.11.0",
		"@vitest/coverage-v8": "^3.2.7",
		"autoprefixer": "^10.5.4",
		"eslint": "^9.39.5",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^5.2.0",
		"eslint-plugin-react-refresh": "^0.4.26",
		"globals": "^16.5.0",
		"jsdom": "^26.1.0",
		"postcss": "^8.5.26",
		"tailwindcss": "^3.4.19",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.67.0",
		"vite": "^7.3.6",
		"vitest": "^3.2.7"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"browserslist": [
		"> 1%",
		"last 2 versions",
		"not dead",
		"not ie 11"
	]
}
